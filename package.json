{
  "name": "privacy-chat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "dev": "node scripts/make-icons.mjs && node scripts/make-theme.mjs && vite",
    "build": "node scripts/make-icons.mjs && node scripts/make-theme.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "theme": "node scripts/make-theme.mjs",
    "check:ui": "node scripts/check-ui.mjs",
    "ui:shots": "node scripts/ui-shots.mjs",
    "test:e2e": "playwright test",
    "audit": "pnpm audit --audit-level=high"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@material/material-color-utilities": "^0.4.0",
    "@material/web": "^2.5.0",
    "preact": "10.24.3",
    "trystero": "^0.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "daisyui": "^5.7.50",
    "tailwindcss": "^4.3.3",
    "typescript": "5.6.3",
    "vite": "6.4.4",
    "vite-plugin-pwa": "0.21.2"
  },
  "pnpm": {
    "overrides": {
      "@grpc/grpc-js": "^1.14.6",
      "@libp2p/peer-store": "^12.0.32"
    }
  }
}
