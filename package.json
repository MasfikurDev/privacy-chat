{
  "name": "privacy-chat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/make-icons.mjs && vite",
    "build": "node scripts/make-icons.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "audit": "pnpm audit --audit-level=high"
  },
  "dependencies": {
    "preact": "10.24.3",
    "trystero": "^0.21.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "typescript": "5.6.3",
    "vite": "6.4.4",
    "vite-plugin-pwa": "0.21.2"
  },
  "pnpm": {
    "overrides": {
      "@grpc/grpc-js": "^1.14.6",
      "@libp2p/peer-store": "^12.0.32"
    }
  }
}
